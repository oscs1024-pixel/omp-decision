{
  "name": "omp-decision",
  "version": "0.2.0",
  "description": "Decision and tool-lifecycle review layer for OMP coding agents",
  "type": "module",
  "main": "./extensions/index.ts",
  "exports": {
    ".": "./extensions/index.ts"
  },
  "files": [
    "extensions",
    "src",
    "skills",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit --pretty false",
    "test": "tsx --test test/**/*.test.ts",
    "check": "npm run typecheck && npm test",
    "pack:check": "npm pack --dry-run",
    "release:check": "npm run check && npm run pack:check"
  },
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ],
    "skills": [
      "./skills/omp-decision/SKILL.md"
    ]
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@oh-my-pi/pi-coding-agent": ">=18.2.6 <19"
  },
  "devDependencies": {
    "@oh-my-pi/pi-coding-agent": "18.2.6",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "license": "MIT",
  "keywords": [
    "omp",
    "oh-my-pi",
    "coding-agent",
    "decision",
    "tool-review"
  ],
  "dependencies": {
    "@typesafe-ai/sdk": "0.6.0"
  }
}
